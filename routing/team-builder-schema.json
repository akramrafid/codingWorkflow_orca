{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orca Team Plan Schema",
  "description": "Schema for machine-readable squad manifests and execution blueprints generated by the Orca Dynamic Team Builder.",
  "type": "object",
  "required": [
    "project",
    "summary",
    "domain_profile",
    "required_capabilities",
    "senior_agents",
    "specialist_agents",
    "optional_agents",
    "excluded_agents",
    "dependencies",
    "parallel_groups",
    "approval_gates",
    "execution_phases"
  ],
  "properties": {
    "project": {
      "type": "string",
      "description": "Identifier or name of the project."
    },
    "summary": {
      "type": "string",
      "description": "Executive summary of the project scope and squad formulation logic."
    },
    "domain_profile": {
      "type": "string",
      "enum": [
        "saas_web_app",
        "ai_llm_rag",
        "classical_ml_data",
        "computer_vision_system",
        "generative_media_multimodal",
        "cloud_infrastructure_platform",
        "lightweight_utility_cli",
        "custom_hybrid"
      ],
      "description": "Primary architectural domain category for the project."
    },
    "required_capabilities": {
      "type": "array",
      "description": "List of functional and technical capabilities extracted from project requirements.",
      "items": {
        "type": "object",
        "required": ["capability", "category", "justification"],
        "properties": {
          "capability": {
            "type": "string",
            "description": "Identifier of the resolved capability."
          },
          "category": {
            "type": "string",
            "enum": [
              "architecture",
              "product_growth",
              "ui_ux_brand",
              "frontend",
              "backend_data",
              "ai_ml_data",
              "quality_security",
              "devops_infra"
            ]
          },
          "justification": {
            "type": "string",
            "description": "Explicit rationale for why this capability is required."
          }
        }
      }
    },
    "senior_agents": {
      "type": "array",
      "description": "Active senior decision-making agents holding domain authority.",
      "items": {
        "type": "object",
        "required": ["agent", "domain", "responsibility"],
        "properties": {
          "agent": {
            "type": "string",
            "enum": [
              "requirement-analyzer",
              "senior-system-architect",
              "senior-product-manager",
              "senior-security-engineer",
              "senior-qa-architect",
              "brand-guardian",
              "senior-devops-engineer",
              "senior-performance-engineer",
              "senior-ai-engineer",
              "senior-cloud-architect",
              "senior-database-architect",
              "senior-product-designer"
            ]
          },
          "domain": {
            "type": "string"
          },
          "responsibility": {
            "type": "string"
          }
        }
      }
    },
    "specialist_agents": {
      "type": "array",
      "description": "Active specialist and support agents executing domain implementations.",
      "items": {
        "type": "object",
        "required": ["agent", "supervising_lead", "deliverables"],
        "properties": {
          "agent": {
            "type": "string",
            "enum": [
              "senior-system-designer",
              "senior-backend-engineer",
              "senior-frontend-engineer",
              "ui-designer",
              "senior-llm-engineer",
              "senior-nlp-engineer",
              "senior-machine-learning-engineer",
              "senior-deep-learning-engineer",
              "senior-generative-ai-engineer",
              "senior-computer-vision-engineer",
              "senior-mlops-engineer",
              "senior-data-engineer",
              "senior-ai-research-engineer",
              "ux-researcher",
              "design-researcher",
              "pinterest-researcher",
              "visual-qa"
            ]
          },
          "supervising_lead": {
            "type": "string"
          },
          "deliverables": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "optional_agents": {
      "type": "array",
      "description": "Agents on standby, activated only if conditional runtime triggers occur.",
      "items": {
        "type": "object",
        "required": ["agent", "standby_condition"],
        "properties": {
          "agent": {
            "type": "string"
          },
          "standby_condition": {
            "type": "string"
          }
        }
      }
    },
    "excluded_agents": {
      "type": "array",
      "description": "Agents explicitly excluded to prevent organizational bloat.",
      "items": {
        "type": "object",
        "required": ["agent", "exclusion_reason"],
        "properties": {
          "agent": {
            "type": "string"
          },
          "exclusion_reason": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "description": "Inter-agent execution and artifact dependencies.",
      "items": {
        "type": "object",
        "required": ["agent", "depends_on", "blocking_artifact"],
        "properties": {
          "agent": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "blocking_artifact": {
            "type": "string"
          }
        }
      }
    },
    "parallel_groups": {
      "type": "array",
      "description": "Isolated concurrent execution groups operating in dedicated worktrees.",
      "items": {
        "type": "object",
        "required": ["group_id", "phase", "worktree", "agents"],
        "properties": {
          "group_id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "worktree": {
            "type": "string"
          },
          "agents": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "approval_gates": {
      "type": "array",
      "description": "Mandatory quality, architecture, brand, security, and deployment review gates.",
      "items": {
        "type": "object",
        "required": ["gate_name", "owner_agent", "mandatory", "criteria"],
        "properties": {
          "gate_name": {
            "type": "string"
          },
          "owner_agent": {
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          },
          "criteria": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "execution_phases": {
      "type": "array",
      "description": "Ordered progression of lifecycle phases for the project.",
      "items": {
        "type": "object",
        "required": ["phase_id", "phase_name", "active_agents", "gate"],
        "properties": {
          "phase_id": {
            "type": "string"
          },
          "phase_name": {
            "type": "string"
          },
          "active_agents": {
            "type": "array",
            "items": { "type": "string" }
          },
          "gate": {
            "type": "string"
          }
        }
      }
    }
  }
}
